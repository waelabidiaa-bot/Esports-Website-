@page "/register"
@rendermode InteractiveServer
@layout PublicLayout
@inject TeamApiService TeamApi
@inject PlayerApiService PlayerApi
@inherits ApiDataPage

<PageTitle>Team Registration — EGames Jam</PageTitle>

<div class="page-header">
    <div>
        <h1>Team & player registration</h1>
        <p class="sub">Signed-in users can create a team or add a player to an existing team</p>
    </div>
    <a href="/teams" class="btn-cyan">Team directory</a>
</div>

@if (!_authChecked)
{
    <div class="empty-state" style="padding:26px;">
        <h5>Checking your session…</h5>
        <p class="mb-0">Please wait while we verify your account.</p>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    <div class="form-card">
        <h3 class="form-card-title">Sign in required</h3>
        <p class="text-dim mb-3">You need to be signed in to register a team or add a player to an existing team.</p>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@LoginLink" class="btn-neon">Sign in</a>
            <a href="@SignUpLink" class="btn-ghost">Create account</a>
        </div>
        <div class="divider"></div>
        <p class="form-hint mb-0">After signing in, you’ll return here to continue.</p>
    </div>
}
else
{
    <div class="register-layout">
        <div>
            @if (!string.IsNullOrEmpty(_successTitle))
            {
                <div class="form-success">
                    <h5>✓ @_successTitle</h5>
                    <p class="mb-3">@_successText</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/teams" class="btn-cyan btn-tiny">View teams</a>
                        <a href="/players" class="btn-cyan btn-tiny">View players</a>
                        <button class="btn-ghost btn-tiny" @onclick="ResetFlow">Register another</button>
                    </div>
                </div>
            }

            <div class="filter-bar">
                <button class="filter-chip @(_mode == "create" ? "active" : "")" @onclick="SetCreateMode">Register a team</button>
                <button class="filter-chip @(_mode == "join" ? "active" : "")" @onclick="SetJoinMode">Add player to team</button>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert mb-4">@_error</div>
            }

            @if (_mode == "create")
            {
                <EditForm Model="model" OnValidSubmit="HandleRegisterTeam" class="form-card">
                    <DataAnnotationsValidator />

                    <h3 class="form-card-title">01 · Team identity</h3>
                    <div class="form-grid">
                        <div>
                            <label class="cyber-label">Team name</label>
                            <InputText @bind-Value="model.TeamName" class="cyber-input" placeholder="e.g. Phantom Vipers" />
                            <ValidationMessage For="@(() => model.TeamName)" />
                        </div>
                        <div>
                            <label class="cyber-label">Team tag</label>
                            <InputText @bind-Value="model.Tag" class="cyber-input" placeholder="e.g. PVP" maxlength="6" />
                            <ValidationMessage For="@(() => model.Tag)" />
                        </div>
                    </div>

                    <div class="divider"></div>

                    <h3 class="form-card-title">02 · Select game</h3>
                    <div class="radio-cards">
                        @foreach (var game in Data.Games.Where(g => g.IsActive).OrderBy(g => g.Name))
                        {
                            <button type="button"
                                    class="radio-card @(_selectedGameId == game.Id ? "selected" : "")"
                                    @onclick="() => SelectGame(game.Id)">
                                @game.Name
                            </button>
                        }
                    </div>

                    <div class="divider"></div>

                    <h3 class="form-card-title">03 · Captain details</h3>
                    <div class="form-grid">
                        <div>
                            <label class="cyber-label">Captain gamertag</label>
                            <InputText @bind-Value="model.CaptainGamertag" class="cyber-input" placeholder="e.g. Nova" />
                            <ValidationMessage For="@(() => model.CaptainGamertag)" />
                        </div>
                        <div>
                            <label class="cyber-label">Captain full name</label>
                            <InputText @bind-Value="model.CaptainFullName" class="cyber-input" placeholder="Captain name" />
                        </div>
                        <div>
                            <label class="cyber-label">Contact email</label>
                            <InputText @bind-Value="model.Email" type="email" class="cyber-input" placeholder="captain@team.gg" />
                            <ValidationMessage For="@(() => model.Email)" />
                        </div>
                        <div>
                            <label class="cyber-label">Region</label>
                            <InputSelect @bind-Value="model.Region" class="cyber-input">
                                <option value="EU">Europe (EU)</option>
                                <option value="NA">North America (NA)</option>
                                <option value="APAC">Asia-Pacific (APAC)</option>
                                <option value="SA">South America (SA)</option>
                                <option value="MENA">Middle East &amp; North Africa (MENA)</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <h3 class="form-card-title">04 · Initial roster (optional, up to 4 more players)</h3>
                    <div class="form-grid">
                        <div>
                            <label class="cyber-label">Player 2 gamertag</label>
                            <InputText @bind-Value="model.Player2" class="cyber-input" placeholder="Optional" />
                        </div>
                        <div>
                            <label class="cyber-label">Player 3 gamertag</label>
                            <InputText @bind-Value="model.Player3" class="cyber-input" placeholder="Optional" />
                        </div>
                        <div>
                            <label class="cyber-label">Player 4 gamertag</label>
                            <InputText @bind-Value="model.Player4" class="cyber-input" placeholder="Optional" />
                        </div>
                        <div>
                            <label class="cyber-label">Player 5 gamertag</label>
                            <InputText @bind-Value="model.Player5" class="cyber-input" placeholder="Optional" />
                        </div>
                    </div>

                    <div class="form-grid mt-3">
                        <div class="full">
                            <label class="d-flex align-items-center gap-2" style="color:var(--text-body); font-size:.9rem;">
                                <InputCheckbox @bind-Value="model.AcceptsRules" />
                                I confirm the team details are valid and accept the tournament rules &amp; fair-play policy.
                            </label>
                            <ValidationMessage For="@(() => model.AcceptsRules)" />
                        </div>
                    </div>

                    <div class="form-actions">
                        <span class="form-hint">Signed in as @Auth.DisplayName · team registration may require admin approval</span>
                        <button type="submit" class="btn-neon" disabled="@_busy">@(_busy ? "Submitting…" : "Register team →")</button>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="joinModel" OnValidSubmit="HandleAddPlayerToTeam" class="form-card">
                    <DataAnnotationsValidator />

                    <h3 class="form-card-title">01 · Filter by game</h3>
                    <div class="radio-cards">
                        <button type="button" class="radio-card @(_selectedGameId == 0 ? "selected" : "")" @onclick="() => SelectGame(0)">All games</button>
                        @foreach (var game in Data.Games.Where(g => g.IsActive).OrderBy(g => g.Name))
                        {
                            <button type="button"
                                    class="radio-card @(_selectedGameId == game.Id ? "selected" : "")"
                                    @onclick="() => SelectGame(game.Id)">
                                @game.Name
                            </button>
                        }
                    </div>

                    <div class="divider"></div>

                    <h3 class="form-card-title">02 · Select existing team</h3>
                    @if (!AvailableTeams.Any())
                    {
                        <div class="empty-state" style="padding:26px;">
                            <h5>No teams with open slots</h5>
                            <p class="mb-0">Try another game or create a new team.</p>
                        </div>
                    }
                    else
                    {
                        <div>
                            <label class="cyber-label">Team</label>
                            <InputSelect @bind-Value="joinModel.TeamId" class="cyber-input">
                                <option value="">Select a team...</option>
                                @foreach (var team in AvailableTeams)
                                {
                                    <option value="@team.Id">@team.Name [@team.Tag] — @team.RosterSize/@team.MaxRoster · @(Data.GameName(team.GameId) ?? "Game")</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => joinModel.TeamId)" />
                        </div>
                    }

                    <div class="divider"></div>

                    <h3 class="form-card-title">03 · Player details</h3>
                    <div class="form-grid">
                        <div>
                            <label class="cyber-label">Gamertag</label>
                            <InputText @bind-Value="joinModel.Gamertag" class="cyber-input" placeholder="e.g. Krypt" />
                            <ValidationMessage For="@(() => joinModel.Gamertag)" />
                        </div>
                        <div>
                            <label class="cyber-label">Full name</label>
                            <InputText @bind-Value="joinModel.FullName" class="cyber-input" placeholder="Player name" />
                        </div>
                        <div>
                            <label class="cyber-label">Email</label>
                            <InputText @bind-Value="joinModel.Email" type="email" class="cyber-input" placeholder="player@team.gg" />
                            <ValidationMessage For="@(() => joinModel.Email)" />
                        </div>
                        <div>
                            <label class="cyber-label">Role</label>
                            <InputSelect @bind-Value="joinModel.Role" class="cyber-input">
                                <option value="Roster">Roster</option>
                                <option value="Captain">Captain</option>
                                <option value="Flex">Flex</option>
                                <option value="Support">Support</option>
                                <option value="Entry">Entry</option>
                                <option value="IGL">IGL</option>
                            </InputSelect>
                        </div>
                        <div>
                            <label class="cyber-label">Country/Region</label>
                            <InputSelect @bind-Value="joinModel.Region" class="cyber-input">
                                <option value="EU">Europe (EU)</option>
                                <option value="NA">North America (NA)</option>
                                <option value="APAC">Asia-Pacific (APAC)</option>
                                <option value="SA">South America (SA)</option>
                                <option value="MENA">Middle East &amp; North Africa (MENA)</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-grid mt-3">
                        <div class="full">
                            <label class="d-flex align-items-center gap-2" style="color:var(--text-body); font-size:.9rem;">
                                <InputCheckbox @bind-Value="joinModel.AcceptsRules" />
                                I confirm this player is eligible and accept the competition rules.
                            </label>
                            <ValidationMessage For="@(() => joinModel.AcceptsRules)" />
                        </div>
                    </div>

                    <div class="form-actions">
                        <span class="form-hint">Signed in as @Auth.DisplayName · player will be added to the selected team</span>
                        <button type="submit" class="btn-neon" disabled="@(_busy || !AvailableTeams.Any())">@(_busy ? "Submitting…" : "Add player to team →")</button>
                    </div>
                </EditForm>
            }
        </div>

        <aside class="summary-card">
            <h4>Registration summary</h4>

            @{
                var selectedGame = _selectedGameId > 0 ? Data.GetGame(_selectedGameId) : null;
                var joinTeam = joinModel.TeamId.HasValue ? Data.GetTeam(joinModel.TeamId.Value) : null;
            }
            @if (selectedGame is not null)
            {
                <GameBanner Game="selectedGame" />
                <div class="mt-2 mb-3 d-flex justify-content-between align-items-center">
                    <span class="text-mono text-dim" style="font-size:.7rem;">Selected game</span>
                    <span class="text-mono" style="color:var(--neon-cyan); font-size:.78rem;">@selectedGame.Name</span>
                </div>
            }

            <div class="summary-row"><span class="k">Mode</span><span class="v">@(_mode == "create" ? "Register team" : "Add player")</span></div>
            <div class="summary-row"><span class="k">Signed in</span><span class="v">@Auth.DisplayName</span></div>
            <div class="summary-row"><span class="k">Team</span><span class="v">@(_mode == "create" ? (string.IsNullOrWhiteSpace(model.TeamName) ? "—" : model.TeamName) : (joinTeam?.Name ?? "—"))</span></div>
            <div class="summary-row"><span class="k">Tag</span><span class="v">@(_mode == "create" ? (string.IsNullOrWhiteSpace(model.Tag) ? "—" : model.Tag.ToUpperInvariant()) : (joinTeam?.Tag ?? "—"))</span></div>
            <div class="summary-row"><span class="k">Region</span><span class="v">@(_mode == "create" ? model.Region : joinModel.Region)</span></div>
            <div class="summary-row"><span class="k">Player</span><span class="v">@(_mode == "create" ? (string.IsNullOrWhiteSpace(model.CaptainGamertag) ? "—" : model.CaptainGamertag) : (string.IsNullOrWhiteSpace(joinModel.Gamertag) ? "—" : joinModel.Gamertag))</span></div>
            <div class="summary-row"><span class="k">Roster</span><span class="v">@(_mode == "create" ? $"{RosterCount} / 5" : $"{joinTeam?.RosterSize ?? 0} / {joinTeam?.MaxRoster ?? 5}")</span></div>

            <div class="divider"></div>

            <span class="text-mono text-dim" style="font-size:.66rem; letter-spacing:1.2px;">How it works</span>
            <div class="step-list">
                <div class="step-item">Sign in with your account.</div>
                <div class="step-item">Register a new team with a captain (and optional roster), or pick an existing team.</div>
                <div class="step-item">Add player details and submit to the API.</div>
                <div class="step-item">Teams/players appear in directories once saved (admin approval may apply for teams).</div>
            </div>
        </aside>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "game")]
    public int? GameId { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    private string _mode = "create";
    private bool _busy;
    private bool _authChecked;
    private int _selectedGameId;
    private TeamRegistrationModel model = new();
    private JoinTeamPlayerModel joinModel = new();
    private string? _successTitle;
    private string? _successText;
    private string? _error;

    private string ReturnPath => "/register" + BuildQuery();
    private string LoginLink => $"/login?returnUrl={Uri.EscapeDataString(ReturnPath)}";
    private string SignUpLink => $"/signup?returnUrl={Uri.EscapeDataString(ReturnPath)}";

    private int RosterCount => 1 + new[] { model.Player2, model.Player3, model.Player4, model.Player5 }
        .Count(p => !string.IsNullOrWhiteSpace(p));

    private IEnumerable<Team> AvailableTeams => Data.Teams
        .Where(t => _selectedGameId == 0 || t.GameId == _selectedGameId)
        .Where(t => t.RosterSize < t.MaxRoster)
        .OrderBy(t => t.Name);

    protected override void OnParametersSet()
    {
        if (GameId is not null && Data.GetGame(GameId.Value) is not null)
            _selectedGameId = GameId.Value;
        else if (_selectedGameId == 0 && Data.Games.Any())
            _selectedGameId = 0; // allow "all games" in join mode; create mode will validate

        if (string.Equals(Mode, "join", StringComparison.OrdinalIgnoreCase))
            _mode = "join";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            await Auth.RestoreAsync();
            _authChecked = true;
            StateHasChanged();
        }
    }

    private string BuildQuery()
    {
        var parts = new List<string>();
        if (_selectedGameId > 0) parts.Add($"game={_selectedGameId}");
        if (_mode == "join") parts.Add("mode=join");
        return parts.Count == 0 ? string.Empty : "?" + string.Join("&", parts);
    }

    private void SelectGame(int id)
    {
        _selectedGameId = id;
        joinModel.TeamId = null;
        _error = null;
    }

    private void SetCreateMode() { _mode = "create"; _error = null; }
    private void SetJoinMode() { _mode = "join"; _error = null; }

    private void ResetFlow()
    {
        _successTitle = null;
        _successText = null;
        _error = null;
        model = new TeamRegistrationModel();
        joinModel = new JoinTeamPlayerModel();
    }

    private async Task HandleRegisterTeam()
    {
        if (_busy || !Auth.IsAuthenticated) return;

        if (_selectedGameId <= 0)
        {
            _error = "Select a game before registering your team.";
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var team = new Team
            {
                Name = model.TeamName.Trim(),
                Tag = model.Tag.Trim().ToUpperInvariant(),
                GameId = _selectedGameId,
                Region = model.Region,
                Captain = model.CaptainGamertag.Trim(),
                MaxRoster = 5,
                Status = "Pending"
            };

            var roster = new List<Player>
            {
                new()
                {
                    Gamertag = model.CaptainGamertag.Trim(),
                    FullName = string.IsNullOrWhiteSpace(model.CaptainFullName) ? model.CaptainGamertag.Trim() : model.CaptainFullName.Trim(),
                    Email = model.Email.Trim(),
                    Role = "Captain",
                    Country = model.Region,
                    Status = "Active"
                }
            };

            foreach (var gamertag in new[] { model.Player2, model.Player3, model.Player4, model.Player5 })
            {
                if (!string.IsNullOrWhiteSpace(gamertag))
                {
                    roster.Add(new Player
                    {
                        Gamertag = gamertag.Trim(),
                        FullName = gamertag.Trim(),
                        Email = string.Empty,
                        Role = "Roster",
                        Country = model.Region,
                        Status = "Active"
                    });
                }
            }

            var created = await TeamApi.RegisterTeamAsync(team, roster);
            await Data.RefreshAsync();

            _successTitle = "Team registered";
            _successText = created is not null
                ? $"Team \"{created.Name}\" [{created.Tag}] was submitted for {Data.GameName(created.GameId) ?? "the selected game"}. Roster entries: {roster.Count}."
                : "Your team registration was submitted.";
            model = new TeamRegistrationModel();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task HandleAddPlayerToTeam()
    {
        if (_busy || !Auth.IsAuthenticated) return;

        if (joinModel.TeamId is null)
        {
            _error = "Select a team to add the player to.";
            return;
        }

        var team = Data.GetTeam(joinModel.TeamId.Value);
        if (team is null)
        {
            _error = "Selected team could not be found. Refresh and try again.";
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var player = new Player
            {
                Gamertag = joinModel.Gamertag.Trim(),
                FullName = string.IsNullOrWhiteSpace(joinModel.FullName) ? joinModel.Gamertag.Trim() : joinModel.FullName.Trim(),
                Email = joinModel.Email.Trim(),
                TeamId = team.Id,
                Role = string.IsNullOrWhiteSpace(joinModel.Role) ? "Roster" : joinModel.Role,
                Country = joinModel.Region,
                Status = "Active"
            };

            var created = await TeamApi.AddPlayerToTeamAsync(team.Id, player);
            await Data.RefreshAsync();

            _successTitle = "Player added to team";
            _successText = created is not null
                ? $"Player \"{created.Gamertag}\" was added to {team.Name} [{team.Tag}]."
                : $"Player was added to {team.Name}.";
            joinModel = new JoinTeamPlayerModel();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public class TeamRegistrationModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Team name is required.")]
        [System.ComponentModel.DataAnnotations.MinLength(3, ErrorMessage = "Use at least 3 characters.")]
        public string TeamName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Team tag is required.")]
        [System.ComponentModel.DataAnnotations.StringLength(6, MinimumLength = 2, ErrorMessage = "Tag must be 2–6 characters.")]
        public string Tag { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Captain gamertag is required.")]
        public string CaptainGamertag { get; set; } = string.Empty;

        public string CaptainFullName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        public string Region { get; set; } = "EU";
        public string Player2 { get; set; } = string.Empty;
        public string Player3 { get; set; } = string.Empty;
        public string Player4 { get; set; } = string.Empty;
        public string Player5 { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the rules to register.")]
        public bool AcceptsRules { get; set; }
    }

    public class JoinTeamPlayerModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Select a team.")]
        public int? TeamId { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Gamertag is required.")]
        public string Gamertag { get; set; } = string.Empty;

        public string FullName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        public string Role { get; set; } = "Roster";
        public string Region { get; set; } = "EU";

        [System.ComponentModel.DataAnnotations.Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the rules.")]
        public bool AcceptsRules { get; set; }
    }
}
