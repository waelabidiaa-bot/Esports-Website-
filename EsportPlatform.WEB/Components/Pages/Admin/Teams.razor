
@page "/admin/teams"

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.Net.Http
@using EsportPlatform.WEB.Models

@rendermode InteractiveServer
@layout AdminLayout

@inject TeamApiService TeamApi
@inject GameApiService GameApi
@inject ApiDataService Data

<PageTitle>Admin — Teams</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized Context="authContext">
        <div class="admin-header">
            <div>
                <h1>Team management</h1>
                <p class="sub">
                    @_teams.Count rosters · @PendingTeams.Count() awaiting approval
                </p>
            </div>

            <button class="btn btn-primary btn-sm px-3"
                    @onclick="ToggleForm">
                @(_showForm ? "Close form" : "+ Add team")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="form-success">
                <h5>✓ Operation complete</h5>
                <p class="mb-0">@_message</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="alert alert-danger" role="alert">
                <strong>Request failed.</strong> @_formError
            </div>
        }

        @if (_loading)
        {
            <p class="text-dim">Loading teams...</p>
        }
        else
        {
            @if (_showForm)
            {
                <div class="form-card mb-4">
                    <h3 class="form-card-title">Register a team manually</h3>

                    @if (!_games.Any())
                    {
                        <div class="alert alert-warning">
                            No games are available. Add a game before registering a team.
                        </div>
                    }
                    else
                    {
                        <EditForm Model="form" OnValidSubmit="AddTeam">
                            <DataAnnotationsValidator />

                            <div class="form-grid">
                                <div>
                                    <label class="cyber-label">Team name</label>
                                    <InputText @bind-Value="form.Name"
                                               class="cyber-input"
                                               placeholder="e.g. Iron Wolves" />
                                    <ValidationMessage For="@(() => form.Name)" />
                                </div>

                                <div>
                                    <label class="cyber-label">Team tag</label>
                                    <InputText @bind-Value="form.Tag"
                                               class="cyber-input"
                                               placeholder="e.g. IRW"
                                               maxlength="6" />
                                    <ValidationMessage For="@(() => form.Tag)" />
                                </div>

                                <div>
                                    <label class="cyber-label">Game</label>
                                    <InputSelect @bind-Value="form.GameId"
                                                 class="cyber-input">
                                        @foreach (var game in _games.OrderBy(g => g.Name))
                                        {
                                            <option value="@game.Id">@game.Name</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div>
                                    <label class="cyber-label">Region</label>
                                    <InputSelect @bind-Value="form.Region"
                                                 class="cyber-input">
                                        <option value="EU">Europe</option>
                                        <option value="NA">North America</option>
                                        <option value="APAC">Asia-Pacific</option>
                                        <option value="SA">South America</option>
                                        <option value="MENA">MENA</option>
                                    </InputSelect>
                                </div>

                                <div>
                                    <label class="cyber-label">Captain gamertag</label>
                                    <InputText @bind-Value="form.Captain"
                                               class="cyber-input"
                                               placeholder="e.g. Steel" />
                                    <ValidationMessage For="@(() => form.Captain)" />
                                </div>

                                <div>
                                    <label class="cyber-label">Initial roster size</label>
                                    <InputNumber @bind-Value="form.RosterSize"
                                                 class="cyber-input"
                                                 min="1"
                                                 max="10" />
                                    <ValidationMessage For="@(() => form.RosterSize)" />
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="button"
                                        class="btn-ghost"
                                        @onclick="CancelForm">
                                    Cancel
                                </button>

                                <button type="submit"
                                        class="btn-neon"
                                        disabled="@_busy">
                                    @(_busy ? "Saving…" : "Add team")
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            }

            <div class="admin-panel">
                <div class="admin-panel-title">
                    <h4>All rosters</h4>
                    <span class="chip pending">
                        @PendingTeams.Count() pending
                    </span>
                </div>

                @if (!_teams.Any())
                {
                    <div class="empty-state" style="padding:34px;">
                        <h5>No teams registered</h5>
                        <p class="mb-0">Add your first team to populate the roster.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="cyber-table">
                            <thead>
                                <tr>
                                    <th>Team</th>
                                    <th>Game</th>
                                    <th>Tournaments</th>
                                    <th>Region</th>
                                    <th>Captain</th>
                                    <th>Roster</th>
                                    <th>Points</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var team in _teams.OrderByDescending(t => t.Points))
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="team-logo">@team.Tag</span>

                                                <div>
                                                    <div class="cell-title">@team.Name</div>
                                                    <div class="cell-sub">
                                                        @team.Tag · joined @team.CreatedAt.ToString("MMM dd")
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td>@GameName(team.GameId)</td>
                                        <td>
                                            @if (team.Tournaments.Any())
                                            {
                                                <div class="admin-tournament-list">
                                                    @foreach (var tournament in team.Tournaments)
                                                    {
                                                        <span class="admin-tournament-chip" title="@tournament.Format · @tournament.Status">
                                                            @tournament.Name
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="cell-sub">Not enrolled</span>
                                            }
                                        </td>
                                        <td>@team.Region</td>
                                        <td>@team.Captain</td>
                                        <td>@team.RosterSize / @team.MaxRoster</td>

                                        <td class="font-orbitron"
                                            style="color:var(--neon-cyan);">
                                            @team.Points
                                        </td>

                                        <td>
                                            <StatusChip Status="@team.Status" />
                                        </td>

                                        <td>
                                            <div class="d-flex gap-1 flex-wrap">
                                                @if (team.Status != "Approved")
                                                {
                                                    <button class="btn btn-sm btn-outline-success btn-tiny"
                                                            disabled="@_busy"
                                                            @onclick="() => Approve(team.Id)">
                                                        Approve
                                                    </button>
                                                }

                                                @if (team.Status != "Suspended")
                                                {
                                                    <button class="btn btn-sm btn-outline-danger btn-tiny"
                                                            disabled="@_busy"
                                                            @onclick="() => Suspend(team.Id)">
                                                        Suspend
                                                    </button>
                                                }

                                                @if (_deleteCandidateId == team.Id)
                                                {
                                                    <button class="btn btn-sm btn-danger btn-tiny"
                                                            disabled="@_busy"
                                                            @onclick="() => DeleteTeam(team.Id)">
                                                        Confirm delete
                                                    </button>

                                                    <button class="btn btn-sm btn-outline-secondary btn-tiny"
                                                            disabled="@_busy"
                                                            @onclick="() => _deleteCandidateId = null">
                                                        Cancel
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-danger btn-tiny"
                                                            disabled="@_busy"
                                                            @onclick="() => _deleteCandidateId = team.Id"
                                                            title="Players become free agents; tournament registration counts are adjusted">
                                                        Delete
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="admin-panel">
            <div class="admin-panel-title">
                <h4>Access denied</h4>
            </div>

            <p>You must sign in with an administrator account to manage teams.</p>
            <a href="/login" class="btn btn-primary btn-sm">Go to login</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<Team> _teams = [];
    private List<Game> _games = [];

    private bool _loading = true;
    private bool _showForm;
    private bool _busy;
    private int? _deleteCandidateId;

    private string? _message;
    private string? _formError;

    private TeamForm form = new();

    private IEnumerable<Team> PendingTeams =>
        _teams.Where(t => t.Status == "Pending");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var teamsTask = TeamApi.GetTeamsAsync();
            var gamesTask = GameApi.GetGamesAsync();

            await Task.WhenAll(teamsTask, gamesTask);

            _teams = (await teamsTask).ToList();
            _games = (await gamesTask).ToList();

            SetDefaultGame();
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex, "load the team directory");
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetDefaultGame()
    {
        if (_games.Count > 0 && !_games.Any(g => g.Id == form.GameId))
        {
            form.GameId = _games[0].Id;
        }
    }

    private void ToggleForm()
    {
        _showForm = !_showForm;
        _formError = null;

        if (_showForm)
        {
            SetDefaultGame();
        }
    }

    private void CancelForm()
    {
        _showForm = false;
        _formError = null;
        form = new TeamForm();
        SetDefaultGame();
    }

    private async Task AddTeam()
    {
        if (_busy)
            return;

        if (!_games.Any(g => g.Id == form.GameId))
        {
            _formError = "Please select a valid game.";
            return;
        }

        _busy = true;
        _message = null;
        _formError = null;

        try
        {
            var team = new Team
            {
                Name = form.Name.Trim(),
                Tag = form.Tag.Trim().ToUpperInvariant(),
                GameId = form.GameId,
                Region = form.Region,
                Captain = form.Captain.Trim(),
                RosterSize = form.RosterSize,
                MaxRoster = 5,
                Points = 0,
                Status = "Approved"
            };

            await TeamApi.AddTeamAsync(team);

            _message = $"Team \"{team.Name}\" added to the roster database.";

            form = new TeamForm();
            SetDefaultGame();

            _showForm = false;

            await ReloadTeamsAsync();
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Approve(int id)
    {
        if (_busy)
            return;

        _busy = true;
        _message = null;
        _formError = null;

        try
        {
            await TeamApi.ApproveTeamAsync(id);

            _message = "Team approved and moved to the verified roster pool.";

            await ReloadTeamsAsync();
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Suspend(int id)
    {
        if (_busy)
            return;

        _busy = true;
        _message = null;
        _formError = null;

        try
        {
            await TeamApi.SuspendTeamAsync(id);

            _message = "Team suspended. They can no longer enter tournaments.";

            await ReloadTeamsAsync();
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteTeam(int id)
    {
        if (_busy)
            return;

        _busy = true;
        _message = null;
        _formError = null;

        try
        {
            await TeamApi.DeleteTeamAsync(id);

            _deleteCandidateId = null;
            await ReloadTeamsAsync();

            _message = "Team deleted. Players are now free agents and tournament counts were updated.";
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex, "delete the team");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadTeamsAsync()
    {
        _deleteCandidateId = null;
        _teams = (await TeamApi.GetTeamsAsync()).ToList();
        await Data.RefreshAsync();
    }

    private string GameName(int gameId)
    {
        return _games.FirstOrDefault(g => g.Id == gameId)?.Name
               ?? "Unknown game";
    }

    public class TeamForm
    {
        [Required(ErrorMessage = "Team name is required.")]
        [MinLength(3, ErrorMessage = "Use at least 3 characters.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Team tag is required.")]
        [StringLength(6, MinimumLength = 2,
            ErrorMessage = "Tag must be 2–6 characters.")]
        public string Tag { get; set; } = string.Empty;

        public int GameId { get; set; }

        public string Region { get; set; } = "EU";

        [Required(ErrorMessage = "Captain gamertag is required.")]
        public string Captain { get; set; } = string.Empty;

        [Range(1, 10, ErrorMessage = "Roster size must be 1–10.")]
        public int RosterSize { get; set; } = 5;
    }
}
