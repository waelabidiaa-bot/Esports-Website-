
@page "/admin/players"

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.Net.Http
@using EsportPlatform.WEB.Models

@rendermode InteractiveServer
@layout AdminLayout

@inject PlayerApiService PlayerApi
@inject TeamApiService TeamApi
@inject ApiDataService Data

<PageTitle>Admin — Players</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized Context="authContext">
        <div class="admin-header">
            <div>
                <h1>Player registry</h1>
                <p class="sub">
                    @_players.Count players ·
                    @_players.Count(p => p.Status == "Active") active
                </p>
            </div>

            <button class="btn btn-primary btn-sm px-3"
                    @onclick="() => _showForm = !_showForm">
                @(_showForm ? "Close form" : "+ Register player")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="form-success">
                <h5>✓ Operation complete</h5>
                <p class="mb-0">@_message</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="alert alert-danger" role="alert">
                <strong>Request failed.</strong> @_formError
            </div>
        }

        @if (_loading)
        {
            <p class="text-dim">Loading players...</p>
        }
        else
        {
            @if (_showForm)
            {
                <div class="form-card mb-4">
                    <h3 class="form-card-title">Register a new player</h3>

                    <EditForm Model="form" OnValidSubmit="AddPlayer">
                        <DataAnnotationsValidator />

                        <div class="form-grid">
                            <div>
                                <label class="cyber-label">Gamertag</label>
                                <InputText @bind-Value="form.Gamertag"
                                           class="cyber-input"
                                           placeholder="e.g. Nova" />
                                <ValidationMessage For="@(() => form.Gamertag)" />
                            </div>

                            <div>
                                <label class="cyber-label">Full name</label>
                                <InputText @bind-Value="form.FullName"
                                           class="cyber-input"
                                           placeholder="e.g. Alex Turner" />
                                <ValidationMessage For="@(() => form.FullName)" />
                            </div>

                            <div>
                                <label class="cyber-label">Email</label>
                                <InputText @bind-Value="form.Email"
                                           type="email"
                                           class="cyber-input"
                                           placeholder="player@team.gg" />
                                <ValidationMessage For="@(() => form.Email)" />
                            </div>

                            <div>
                                <label class="cyber-label">Assign team</label>
                                <InputSelect @bind-Value="form.TeamId"
                                             class="cyber-input">
                                    <option value="">Free agent (no team)</option>

                                    @foreach (var team in _teams.OrderBy(t => t.Name))
                                    {
                                        <option value="@team.Id">
                                            @team.Name [@team.Tag]
                                        </option>
                                    }
                                </InputSelect>
                            </div>

                            <div>
                                <label class="cyber-label">Role</label>
                                <InputSelect @bind-Value="form.Role"
                                             class="cyber-input">
                                    <option value="Captain">Captain</option>
                                    <option value="Duelist">Duelist</option>
                                    <option value="Controller">Controller</option>
                                    <option value="Sentinel">Sentinel</option>
                                    <option value="Initiator">Initiator</option>
                                    <option value="IGL">IGL</option>
                                    <option value="AWPer">AWPer</option>
                                    <option value="Carry">Carry</option>
                                    <option value="Support">Support</option>
                                    <option value="Flex">Flex</option>
                                </InputSelect>
                            </div>

                            <div>
                                <label class="cyber-label">Country code</label>
                                <InputText @bind-Value="form.Country"
                                           class="cyber-input"
                                           placeholder="e.g. SE"
                                           maxlength="3" />
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="button"
                                    class="btn-ghost"
                                    @onclick="CancelForm">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="btn-neon"
                                    disabled="@_busy">
                                @(_busy ? "Saving…" : "Register player")
                            </button>
                        </div>
                    </EditForm>
                </div>
            }

            <div class="admin-panel">
                <div class="admin-panel-title">
                    <h4>Player roster</h4>
                    <span class="text-mono text-dim" style="font-size:.65rem;">
                        @_players.Count total
                    </span>
                </div>

                @if (!_players.Any())
                {
                    <div class="empty-state" style="padding:34px;">
                        <h5>No players registered</h5>
                        <p class="mb-0">
                            Register your first player to populate the roster.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="cyber-table">
                            <thead>
                                <tr>
                                    <th>Player</th>
                                    <th>Team</th>
                                    <th>Role</th>
                                    <th>Country</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var player in _players.OrderBy(p => p.Gamertag))
                                {
                                    <tr>
                                        <td>
                                            <div class="cell-title">
                                                @player.Gamertag
                                            </div>
                                            <div class="cell-sub">
                                                @player.FullName
                                            </div>
                                        </td>

                                        <td>
                                            @if (GetTeam(player.TeamId) is not null)
                                            {
                                                <span>@TeamName(player.TeamId)</span>
                                            }
                                            else
                                            {
                                                <span class="chip">Free agent</span>
                                            }
                                        </td>

                                        <td>@player.Role</td>
                                        <td class="cell-sub">@player.Country</td>
                                        <td class="cell-sub">@player.Email</td>

                                        <td>
                                            <StatusChip Status="@player.Status" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="admin-panel">
            <div class="admin-panel-title">
                <h4>Access denied</h4>
            </div>

            <p>You must sign in with an administrator account to manage players.</p>
            <a href="/login" class="btn btn-primary btn-sm">Go to login</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<Player> _players = [];
    private List<Team> _teams = [];

    private bool _loading = true;
    private bool _showForm;
    private bool _busy;

    private string? _message;
    private string? _formError;

    private PlayerForm form = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var playersTask = PlayerApi.GetPlayersAsync();
            var teamsTask = TeamApi.GetTeamsAsync();

            await Task.WhenAll(playersTask, teamsTask);

            _players = (await playersTask).ToList();
            _teams = (await teamsTask).ToList();
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex, "load the player registry");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddPlayer()
    {
        if (_busy)
            return;

        _busy = true;
        _formError = null;
        _message = null;

        try
        {
            var player = new Player
            {
                Gamertag = form.Gamertag.Trim(),
                FullName = form.FullName.Trim(),
                Email = form.Email.Trim(),
                TeamId = form.TeamId,
                Role = form.Role,
                Country = form.Country.Trim().ToUpperInvariant(),
                Status = "Active"
            };

            await PlayerApi.AddPlayerAsync(player);

            _message = $"Player \"{player.Gamertag}\" registered to the registry.";

            form = new PlayerForm();
            _showForm = false;

            _players = (await PlayerApi.GetPlayersAsync()).ToList();
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private Team? GetTeam(int? teamId)
    {
        if (teamId is null)
            return null;

        return _teams.FirstOrDefault(t => t.Id == teamId.Value);
    }

    private string TeamName(int? teamId)
    {
        return GetTeam(teamId)?.Name ?? "Unknown team";
    }

    private void CancelForm()
    {
        _showForm = false;
        _formError = null;
        form = new PlayerForm();
    }

    public class PlayerForm
    {
        [Required(ErrorMessage = "Gamertag is required.")]
        public string Gamertag { get; set; } = string.Empty;

        [Required(ErrorMessage = "Full name is required.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        public int? TeamId { get; set; }

        public string Role { get; set; } = "Flex";

        public string Country { get; set; } = "EU";
    }
}
