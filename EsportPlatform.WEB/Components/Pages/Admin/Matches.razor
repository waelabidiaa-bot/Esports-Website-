
@page "/admin/matches"

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using EsportPlatform.WEB.Models
@using EsportPlatform.WEB.Services
@using System.Net.Http

@rendermode InteractiveServer
@layout AdminLayout

@inject MatchApiService MatchApi
@inject TournamentApiService TournamentApi
@inject TeamApiService TeamApi
@inject GameApiService GameApi
@inject ApiDataService Data

<PageTitle>Admin — Matches</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized Context="authContext">
        @if (_loading)
        {
            <div class="text-center p-4">
                <p>Loading matches...</p>
            </div>
        }
        else
        {
            <div class="admin-header">
                <div>
                    <h1>Match scheduler</h1>
                    <p class="sub">
                        @_matches.Count matches ·
                        @_matches.Count(m => m.Status == "Live") live now
                    </p>
                </div>

                <button class="btn btn-primary btn-sm px-3"
                        @onclick="() => _showForm = !_showForm">
                    @(_showForm ? "Close form" : "+ Schedule match")
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="form-success">
                    <h5>✓ Operation complete</h5>
                    <p class="mb-0">@_message</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="alert alert-danger" role="alert">
                    <strong>Request failed.</strong> @_formError
                </div>
            }

            @if (_showForm)
            {
                <div class="form-card mb-4">
                    <h3 class="form-card-title">Schedule a new match</h3>

                    @if (!_tournaments.Any())
                    {
                        <div class="alert alert-warning">
                            You need to create a tournament before scheduling a match.
                        </div>
                    }
                    else
                    {
                        <EditForm Model="form" OnValidSubmit="AddMatch">
                            <DataAnnotationsValidator />

                            <div class="form-grid">
                                <div class="full">
                                    <label class="cyber-label">Tournament</label>

                                    <InputSelect @bind-Value="form.TournamentId"
                                                 @bind-Value:after="OnTournamentChanged"
                                                 class="cyber-input">
                                        @foreach (var tournament in _tournaments)
                                        {
                                            <option value="@tournament.Id">
                                                @tournament.Name — @GameName(tournament.GameId)
                                            </option>
                                        }
                                    </InputSelect>

                                    @if (SelectedTournament is { } selectedTournament)
                                    {
                                        <p class="cell-sub mt-1 mb-0">
                                            @selectedTournament.StartDate.ToString("MMM dd")
                                            – @selectedTournament.EndDate.ToString("MMM dd")
                                            · approved @GameName(selectedTournament.GameId) teams only
                                        </p>

                                        @if (IsClosedTournament(selectedTournament))
                                        {
                                            <p class="text-danger mt-1 mb-0">
                                                This tournament is closed and no longer accepts matches.
                                            </p>
                                        }
                                    }
                                </div>

                                <div>
                                    <label class="cyber-label">Team Alpha</label>

                                    <InputSelect @bind-Value="form.TeamAId"
                                                 class="cyber-input">
                                        <option value="">TBD</option>

                                        @foreach (var team in EligibleTeams)
                                        {
                                            <option value="@team.Id">
                                                @team.Name [@team.Tag]
                                            </option>
                                        }
                                    </InputSelect>
                                </div>

                                <div>
                                    <label class="cyber-label">Team Bravo</label>

                                    <InputSelect @bind-Value="form.TeamBId"
                                                 class="cyber-input">
                                        <option value="">TBD</option>

                                        @foreach (var team in EligibleTeams)
                                        {
                                            <option value="@team.Id">
                                                @team.Name [@team.Tag]
                                            </option>
                                        }
                                    </InputSelect>
                                </div>

                                <div>
                                    <label class="cyber-label">Stage</label>

                                    <InputText @bind-Value="form.Stage"
                                               class="cyber-input"
                                               placeholder="e.g. Quarterfinal" />
                                </div>

                                <div>
                                    <label class="cyber-label">Best of</label>

                                    <InputSelect @bind-Value="form.BestOf"
                                                 class="cyber-input">
                                        <option value="Bo1">Best of 1</option>
                                        <option value="Bo3">Best of 3</option>
                                        <option value="Bo5">Best of 5</option>
                                        <option value="Bo7">Best of 7</option>
                                    </InputSelect>
                                </div>

                                <div>
                                    <label class="cyber-label">Match date &amp; time</label>

                                    <InputDate @bind-Value="form.ScheduledAt"
                                               Type="InputDateType.DateTimeLocal"
                                               min="@MinScheduleDate"
                                               max="@MaxScheduleDate"
                                               class="cyber-input" />
                                </div>

                                <div>
                                    <label class="cyber-label">Status</label>

                                    <InputSelect @bind-Value="form.Status"
                                                 class="cyber-input">
                                        <option value="Upcoming">Upcoming</option>
                                        <option value="Live">Live</option>
                                        <option value="Completed">Completed</option>
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="button"
                                        class="btn-ghost"
                                        @onclick="CancelForm">
                                    Cancel
                                </button>

                                <button type="submit"
                                        class="btn-neon"
                                        disabled="@(_busy || (SelectedTournament is { } t && IsClosedTournament(t)))">
                                    @(_busy ? "Scheduling…" : "Schedule match")
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            }

            <div class="admin-panel">
                <div class="admin-panel-title">
                    <h4>Match queue</h4>

                    <span class="text-mono text-dim" style="font-size:.65rem;">
                        Season 12
                    </span>
                </div>

                @if (!_matches.Any())
                {
                    <div class="empty-state" style="padding:34px;">
                        <h5>No matches scheduled</h5>
                        <p class="mb-0">
                            Schedule your first match to populate the match center.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="cyber-table">
                            <thead>
                                <tr>
                                    <th>Match</th>
                                    <th>Tournament</th>
                                    <th>Stage</th>
                                    <th>Score</th>
                                    <th>Schedule</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var match in _matches.OrderBy(m => m.ScheduledAt))
                                {
                                    <tr>
                                        <td>
                                            <div class="cell-title">
                                                @TeamName(match.TeamAId) vs @TeamName(match.TeamBId)
                                            </div>

                                            <div class="cell-sub">
                                                @GameName(match.GameId) · @match.BestOf
                                            </div>
                                        </td>

                                        <td>
                                            @TournamentName(match.TournamentId)
                                        </td>

                                        <td class="cell-sub">
                                            @match.Stage
                                        </td>

                                        <td>
                                            <div class="d-flex align-items-center gap-1">
                                                <button class="btn btn-sm btn-outline-danger btn-tiny"
                                                        disabled="@(_busy || match.ScoreA == 0)"
                                                        @onclick="() => AdjustScore(match.Id, true, -1)"
                                                        title="Remove point from team A">
                                                    A−
                                                </button>

                                                <button class="btn btn-sm btn-outline-info btn-tiny"
                                                        disabled="@_busy"
                                                        @onclick="() => AdjustScore(match.Id, true, 1)"
                                                        title="Add point to team A">
                                                    A+
                                                </button>

                                                <span class="scoreline-value"
                                                      style="font-size:.9rem;">
                                                    @match.ScoreA : @match.ScoreB
                                                </span>

                                                <button class="btn btn-sm btn-outline-danger btn-tiny"
                                                        disabled="@(_busy || match.ScoreB == 0)"
                                                        @onclick="() => AdjustScore(match.Id, false, -1)"
                                                        title="Remove point from team B">
                                                    B−
                                                </button>

                                                <button class="btn btn-sm btn-outline-info btn-tiny"
                                                        disabled="@_busy"
                                                        @onclick="() => AdjustScore(match.Id, false, 1)"
                                                        title="Add point to team B">
                                                    B+
                                                </button>
                                            </div>
                                        </td>

                                        <td class="cell-sub">
                                            @match.ScheduledAt.ToString("MMM dd · HH:mm")
                                        </td>

                                        <td>
                                            <StatusChip Status="@match.Status" />
                                        </td>

                                        <td>
                                            <div class="d-flex gap-1 flex-wrap">
                                                @if (match.Status != "Live" &&
                                                     match.Status != "Completed")
                                                {
                                                    <button class="btn btn-sm btn-outline-danger btn-tiny"
                                                            disabled="@_busy"
                                                            @onclick="() => GoLive(match.Id)">
                                                        Go live
                                                    </button>
                                                }

                                                @if (match.Status != "Completed")
                                                {
                                                    <button class="btn btn-sm btn-outline-success btn-tiny"
                                                            disabled="@_busy"
                                                            @onclick="() => Finalize(match.Id)">
                                                        Finalize
                                                    </button>
                                                }

                                                @if (_deleteCandidateId == match.Id)
                                                {
                                                    <button class="btn btn-sm btn-danger btn-tiny"
                                                            disabled="@_busy"
                                                            @onclick="() => DeleteMatch(match.Id)">
                                                        Confirm delete
                                                    </button>

                                                    <button class="btn btn-sm btn-outline-secondary btn-tiny"
                                                            disabled="@_busy"
                                                            @onclick="() => _deleteCandidateId = null">
                                                        Cancel
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-danger btn-tiny"
                                                            disabled="@_busy"
                                                            @onclick="() => _deleteCandidateId = match.Id">
                                                        Delete
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="admin-panel">
            <div class="admin-panel-title">
                <h4>Access denied</h4>
            </div>

            <p>You must sign in with an administrator account to manage matches.</p>
            <a href="/login" class="btn btn-primary btn-sm">Go to login</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _loading = true;
    private bool _showForm;
    private bool _busy;
    private int? _deleteCandidateId;

    private string? _message;
    private string? _formError;

    private List<GameMatch> _matches = [];
    private List<Tournament> _tournaments = [];
    private List<Team> _teams = [];
    private List<Game> _games = [];

    private MatchForm form = new();

    // Load the data required by the page.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var matchesTask = MatchApi.GetMatchesAsync();
            var tournamentsTask = TournamentApi.GetTournamentsAsync();
            var teamsTask = TeamApi.GetTeamsAsync();
            var gamesTask = GameApi.GetGamesAsync();

            await Task.WhenAll(
                matchesTask,
                tournamentsTask,
                teamsTask,
                gamesTask
            );

            _matches = await matchesTask;
            _tournaments = await tournamentsTask;
            _teams = await teamsTask;
            _games = await gamesTask;

            if (_tournaments.Any())
            {
                form.TournamentId = _tournaments[0].Id;
                form.ScheduledAt = DefaultScheduleDate(SelectedTournament);
            }
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex, "load the match center");
        }
        finally
        {
            _loading = false;
        }
    }

    // Tournament selected in the form.
    private Tournament? SelectedTournament =>
        _tournaments.FirstOrDefault(t => t.Id == form.TournamentId);

    // Only approved teams belonging to the selected tournament's game
    // are eligible to be scheduled.
    private IEnumerable<Team> EligibleTeams =>
        SelectedTournament is null
            ? Enumerable.Empty<Team>()
            : _teams
                .Where(t => t.GameId == SelectedTournament.GameId &&
                            string.Equals(
                                t.Status,
                                "Approved",
                                StringComparison.OrdinalIgnoreCase))
                .OrderBy(t => t.Name);

    private string? MinScheduleDate =>
        SelectedTournament is null
            ? null
            : SelectedTournament.StartDate
                .Date
                .ToString("yyyy-MM-ddTHH:mm");

    private string? MaxScheduleDate =>
        SelectedTournament is null
            ? null
            : SelectedTournament.EndDate
                .Date
                .AddDays(1)
                .AddMinutes(-1)
                .ToString("yyyy-MM-ddTHH:mm");

    // Changing the tournament invalidates team choices and moves the date
    // inside the new tournament window.
    private void OnTournamentChanged()
    {
        form.TeamAId = null;
        form.TeamBId = null;
        form.ScheduledAt = DefaultScheduleDate(SelectedTournament);
        _formError = null;
    }

    // Schedule a new match.
    private async Task AddMatch()
    {
        if (_busy)
            return;

        var validationError = ValidateSchedule();
        if (validationError is not null)
        {
            _formError = validationError;
            return;
        }

        var tournament = SelectedTournament!;

        _busy = true;
        _message = null;
        _formError = null;

        try
        {
            var match = new GameMatch
            {
                TournamentId = form.TournamentId,
                GameId = tournament.GameId,

                TeamAId = form.TeamAId,
                TeamBId = form.TeamBId,

                ScoreA = 0,
                ScoreB = 0,

                Stage = form.Stage.Trim(),

                BestOf = form.BestOf,
                ScheduledAt = form.ScheduledAt,
                Status = form.Status
            };

            var created = await MatchApi.AddMatchAsync(match);

            if (created is null)
            {
                _formError =
                    "The match could not be scheduled. Check the teams, date, and stage.";
                return;
            }

            await ReloadMatchesAsync();

            _message = "Match scheduled and pushed to the match center.";

            ResetForm();
            _showForm = false;
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    // Mirrors the scheduling rules enforced by the API so the admin gets
    // immediate feedback instead of a generic failed request.
    private string? ValidateSchedule()
    {
        var tournament = SelectedTournament;

        if (tournament is null)
        {
            return "Please select a valid tournament.";
        }

        if (IsClosedTournament(tournament))
        {
            return "This tournament is closed and no longer accepts matches.";
        }

        if (string.IsNullOrWhiteSpace(form.Stage))
        {
            return "A stage is required (for example: Group Stage, Quarterfinal).";
        }

        var hasTeamA = form.TeamAId.HasValue;
        var hasTeamB = form.TeamBId.HasValue;

        if (hasTeamA != hasTeamB)
        {
            return "Select both teams, or leave both sides as TBD.";
        }

        if (!hasTeamA &&
            !string.Equals(form.Status, "Upcoming", StringComparison.OrdinalIgnoreCase))
        {
            return "Only Upcoming matches can leave both teams as TBD.";
        }

        if (hasTeamA && form.TeamAId == form.TeamBId)
        {
            return "Team Alpha and Team Bravo must be different.";
        }

        if (form.ScheduledAt == default)
        {
            return "Choose a match date and time.";
        }

        if (form.ScheduledAt.Date < tournament.StartDate.Date ||
            form.ScheduledAt.Date > tournament.EndDate.Date)
        {
            return $"The match must be played between " +
                   $"{tournament.StartDate:MMM dd} and {tournament.EndDate:MMM dd}.";
        }

        if (!(hasTeamA && hasTeamB))
        {
            return null;
        }

        var teamA = form.TeamAId!.Value;
        var teamB = form.TeamBId!.Value;
        var eligibleIds = EligibleTeams
            .Select(t => t.Id)
            .ToHashSet();

        if (!eligibleIds.Contains(teamA) || !eligibleIds.Contains(teamB))
        {
            return $"Only approved {GameName(tournament.GameId)} teams can play " +
                   $"in this tournament.";
        }

        var stage = form.Stage.Trim();

        foreach (var existing in _matches)
        {
            // A pairing can only appear once per stage of a tournament.
            if (existing.TournamentId == tournament.Id &&
                string.Equals(
                    (existing.Stage ?? string.Empty).Trim(),
                    stage,
                    StringComparison.OrdinalIgnoreCase) &&
                IsSamePair(existing.TeamAId, existing.TeamBId, teamA, teamB))
            {
                return $"This pairing already exists in {stage}. " +
                       $"Each pairing can only appear once per stage.";
            }

            // A team cannot be in two matches at the same date and time,
            // even across different tournaments.
            if (existing.ScheduledAt == form.ScheduledAt &&
                (existing.TeamAId == teamA ||
                 existing.TeamBId == teamA ||
                 existing.TeamAId == teamB ||
                 existing.TeamBId == teamB))
            {
                return "One of these teams is already scheduled at that date and time.";
            }
        }

        return null;
    }

    // Change match status to Live.
    private async Task GoLive(int id)
    {
        await ExecuteMatchAction(
            () => MatchApi.SetMatchLiveAsync(id),
            "Match is now live on the public match center."
        );
    }

    // Finalize a match.
    private async Task Finalize(int id)
    {
        await ExecuteMatchAction(
            () => MatchApi.FinalizeMatchAsync(id),
            "Match finalized and moved to results."
        );
    }

    // Delete the whole match record after an inline confirmation step.
    private async Task DeleteMatch(int id)
    {
        if (_busy)
            return;

        _busy = true;
        _message = null;
        _formError = null;

        try
        {
            await MatchApi.DeleteMatchAsync(id);

            _deleteCandidateId = null;
            await ReloadMatchesAsync();

            _message = "Match deleted from the match center.";
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    // Change one team's score by the supplied delta.
    private async Task AdjustScore(int id, bool teamA, int delta)
    {
        if (_busy)
            return;

        _busy = true;
        _message = null;
        _formError = null;

        try
        {
            var updated = await MatchApi.AdjustScoreAsync(id, teamA, delta);

            await ReloadMatchesAsync();

            if (updated is null)
            {
                _formError = "Could not update the score for this match.";
                return;
            }

            _message =
                $"{TeamName(updated.TeamAId)} {updated.ScoreA} : {updated.ScoreB} " +
                $"{TeamName(updated.TeamBId)} — score updated.";
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    // Shared logic for match status operations.
    private async Task ExecuteMatchAction(
        Func<Task> action,
        string successMessage)
    {
        if (_busy)
            return;

        _busy = true;
        _message = null;
        _formError = null;

        try
        {
            await action();

            await ReloadMatchesAsync();

            _message = successMessage;
        }
        catch (Exception ex)
        {
            _formError = ApiDataService.DescribeError(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    // Reload matches after modifications.
    private async Task ReloadMatchesAsync()
    {
        _deleteCandidateId = null;
        _matches = await MatchApi.GetMatchesAsync();
        await Data.RefreshAsync();
    }

    // Display helper methods.
    private string TeamName(int? teamId)
    {
        if (teamId is null)
            return "TBD";

        return _teams.FirstOrDefault(t => t.Id == teamId)?.Name
               ?? "Unknown team";
    }

    private string GameName(int gameId)
    {
        return _games.FirstOrDefault(g => g.Id == gameId)?.Name
               ?? $"Game #{gameId}";
    }

    private string TournamentName(int tournamentId)
    {
        return _tournaments.FirstOrDefault(t => t.Id == tournamentId)?.Name
               ?? "Unknown tournament";
    }

    private void CancelForm()
    {
        _showForm = false;
        _formError = null;

        ResetForm();
    }

    private void ResetForm()
    {
        form = new MatchForm();

        if (_tournaments.Any())
        {
            form.TournamentId = _tournaments[0].Id;
            form.ScheduledAt = DefaultScheduleDate(SelectedTournament);
        }
    }

    private static bool IsClosedTournament(Tournament tournament)
    {
        return tournament.Status is not null &&
               (tournament.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ||
                tournament.Status.Equals("Finished", StringComparison.OrdinalIgnoreCase) ||
                tournament.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) ||
                tournament.Status.Equals("Archived", StringComparison.OrdinalIgnoreCase));
    }

    private static bool IsSamePair(
        int? teamAId,
        int? teamBId,
        int firstTeamId,
        int secondTeamId)
    {
        return (teamAId == firstTeamId && teamBId == secondTeamId) ||
               (teamAId == secondTeamId && teamBId == firstTeamId);
    }

    private static DateTime DefaultScheduleDate(Tournament? tournament)
    {
        var candidate = DateTime.Today.AddDays(1).AddHours(18);

        if (tournament is null)
        {
            return candidate;
        }

        var start = tournament.StartDate.Date.AddHours(18);
        var end = tournament.EndDate.Date.AddHours(18);

        if (candidate < start)
        {
            return start;
        }

        if (candidate > end)
        {
            return end;
        }

        return candidate;
    }

    public class MatchForm
    {
        public int TournamentId { get; set; } = 1;

        public int? TeamAId { get; set; }

        public int? TeamBId { get; set; }

        public string Stage { get; set; } = "Group Stage";

        public string BestOf { get; set; } = "Bo3";

        public DateTime ScheduledAt { get; set; } =
            DateTime.Today.AddDays(1).AddHours(18);

        public string Status { get; set; } = "Upcoming";
    }
}
