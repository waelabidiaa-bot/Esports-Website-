@page "/Error"
@layout PublicLayout
@using System.Diagnostics

<PageTitle>Something went wrong — EGames Jam</PageTitle>

<div class="cyber-panel p-5 text-center my-5">
    <span class="text-mono text-dim" style="font-size:.7rem; letter-spacing:2px;">ERROR</span>
    <h1 class="mt-2 mb-3">Something went wrong</h1>
    <p class="text-secondary mb-4">
        We couldn't process that request. Please try again, or head back to the arena.
    </p>

    @if (ShowRequestId)
    {
        <p class="text-dim mb-4" style="font-size:.8rem;">
            Reference: <code>@RequestId</code>
        </p>
    }

    <a href="/" class="btn btn-primary px-4 py-2">Back to home</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
