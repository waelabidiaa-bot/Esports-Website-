@page "/tournaments"
@rendermode InteractiveServer
@layout PublicLayout
@inherits ApiDataPage

<PageTitle>Tournaments — EGames Jam</PageTitle>

<div class="page-header">
    <div>
        <h1>Lock in your run</h1>
        <p class="sub">@Data.Tournaments.Count(t => t.Status is "Live" or "Open") events taking teams right now · $@Data.Tournaments.Sum(t => t.PrizePool).ToString("N0") on the line</p>
    </div>
    <a href="/register" class="btn-neon">Register a team</a>
</div>

<div class="filter-bar">
    <button class="filter-chip @(_status == "All" ? "active" : "")" @onclick="ShowAll">All events</button>
    <button class="filter-chip @(_status == "Live" ? "active" : "")" @onclick="ShowLive">Live</button>
    <button class="filter-chip @(_status == "Open" ? "active" : "")" @onclick="ShowOpen">Registration open</button>
    <button class="filter-chip @(_status == "Upcoming" ? "active" : "")" @onclick="ShowUpcoming">Upcoming</button>
    <button class="filter-chip @(_status == "Completed" ? "active" : "")" @onclick="ShowCompleted">Completed</button>

    <select class="cyber-input filter-search" @bind="_gameId">
        <option value="0">All games</option>
        @foreach (var game in Data.Games.OrderBy(g => g.Name))
        {
            <option value="@game.Id">@game.Name</option>
        }
    </select>
</div>

@if (!FilteredTournaments.Any())
{
    <div class="empty-state">
        <h5>No events in this view</h5>
        <p class="mb-0">Try a different game or status filter.</p>
    </div>
}
else
{
    <div class="arena-grid">
        @{ var index = 0; }
        @foreach (var tournament in FilteredTournaments)
        {
            var delay = index++ * 70;
            var game = Data.GetGame(tournament.GameId);
            var accent = game?.Accent ?? "#dc2626";
            var spotsLeft = Math.Max(0, tournament.MaxTeams - tournament.RegisteredTeams);
            var isLive = tournament.Status == "Live";
            var isCompleted = tournament.Status == "Completed";
            var isOpenForRegistration = IsOpenForRegistration(tournament, spotsLeft);

            <article class="arena-card tournament-arena @(isLive ? "is-live" : "")"
                     style="--accent:@accent; --delay:@(delay)ms;">
                <div class="arena-banner">
                    @if (game is not null)
                    {
                        <GameBanner Game="game" />
                    }
                    <div class="arena-scan"></div>
                    <span class="arena-badge">@tournament.Format</span>
                    <span class="arena-status @(isLive ? "is-hot" : "")">
                        <span class="arena-dot"></span>
                        @GetBannerLabel(tournament, spotsLeft)
                    </span>
                </div>

                <div class="arena-body">
                    <div class="arena-kicker">
                        <span>@(game?.Name ?? "Open circuit")</span>
                        <span>@FormatDateRange(tournament)</span>
                    </div>

                    <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                        <h3 class="arena-title mb-0">@tournament.Name</h3>
                        <StatusChip Status="@tournament.Status" />
                    </div>
                    <p class="arena-desc">@(!string.IsNullOrWhiteSpace(tournament.Description) ? tournament.Description : "Tournament details will be announced soon.")</p>

                    <div class="arena-prize">
                        <span class="arena-prize-label">Prize pool</span>
                        <strong>$@tournament.PrizePool.ToString("N0")</strong>
                    </div>

                    <div class="arena-slots">
                        <div class="arena-slots-head">
                            <span>Team slots</span>
                            <span>@tournament.RegisteredTeams / @tournament.MaxTeams</span>
                        </div>
                        <div class="arena-progress">
                            <span style="width:@FillPercent(tournament)"></span>
                        </div>
                    </div>

                    <div class="arena-actions">
                        @if (isOpenForRegistration)
                        {
                            <a href="/register?game=@tournament.GameId" class="arena-cta">Register team <span>→</span></a>
                        }
                        else if (isCompleted)
                        {
                            <span class="arena-full">Event completed</span>
                        }
                        else if (spotsLeft <= 0)
                        {
                            <span class="arena-full">Fully booked</span>
                        }
                        else
                        {
                            <span class="arena-full">Registration closed</span>
                        }
                        <a href="/scores" class="arena-ghost">Match center</a>
                    </div>
                </div>
            </article>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "game")]
    public int? GameId { get; set; }

    private string _status = "All";
    private int _gameId;

    protected override void OnParametersSet()
    {
        if (GameId is not null)
        {
            _gameId = GameId.Value;
        }
    }

    private IEnumerable<Tournament> FilteredTournaments => Data.Tournaments
        .Where(t => _status switch
        {
            "All" => true,
            "Open" => IsOpenForRegistration(t),
            "Live" => t.Status == "Live",
            "Upcoming" => t.Status == "Upcoming",
            "Completed" => t.Status == "Completed",
            _ => t.Status == _status
        })
        .Where(t => _gameId == 0 || t.GameId == _gameId)
        .OrderBy(t => StatusRank(t.Status))
        .ThenBy(t => t.StartDate == default ? DateTime.MaxValue : t.StartDate);

    private static bool IsOpenForRegistration(Tournament t, int? spotsLeft = null)
    {
        var left = spotsLeft ?? Math.Max(0, t.MaxTeams - t.RegisteredTeams);
        return t.Status == "Upcoming" && left > 0 && (t.StartDate == default || t.StartDate.Date >= DateTime.Today);
    }

    private static int StatusRank(string? status) => status switch
    {
        "Live" => 0,
        "Upcoming" => 1,
        "Completed" => 2,
        _ => 3
    };

    private static string GetBannerLabel(Tournament t, int spotsLeft)
    {
        if (t.Status == "Live") return "Live now";
        if (t.Status == "Completed") return "Completed";
        if (IsOpenForRegistration(t, spotsLeft)) return $"{spotsLeft} slots left";
        if (spotsLeft <= 0) return "Fully booked";
        return t.Status;
    }

    private static string FormatDateRange(Tournament t)
    {
        if (t.StartDate == default && t.EndDate == default) return "Dates TBA";
        if (t.StartDate == default) return $"Until {t.EndDate:MMM dd}";
        if (t.EndDate == default) return $"From {t.StartDate:MMM dd}";
        return $"{t.StartDate:MMM dd} – {t.EndDate:MMM dd}";
    }

    private static string FillPercent(Tournament tournament)
    {
        if (tournament.MaxTeams <= 0) return "0%";
        var pct = Math.Clamp((double)tournament.RegisteredTeams / tournament.MaxTeams * 100, 0, 100);
        return $"{Math.Round(pct)}%";
    }

    private void ShowAll() => _status = "All";
    private void ShowLive() => _status = "Live";
    private void ShowOpen() => _status = "Open";
    private void ShowUpcoming() => _status = "Upcoming";
    private void ShowCompleted() => _status = "Completed";
}
