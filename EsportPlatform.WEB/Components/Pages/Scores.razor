@page "/scores"
@rendermode InteractiveServer
@layout PublicLayout
@inherits ApiDataPage

<PageTitle>Match Center — EGames Jam</PageTitle>

<div class="page-header">
    <div>
        <h1>Match center</h1>
        <p class="sub">Live scores, upcoming schedule &amp; recent results</p>
    </div>
    <a href="/highlights" class="btn-neon">✦ Watch highlights</a>
</div>

<div class="content-with-aside">
    <div>
        <div class="filter-bar">
            <button class="filter-chip @(_filter == "All" ? "active" : "")" @onclick="ShowAll">All</button>
            <button class="filter-chip @(_filter == "Live" ? "active" : "")" @onclick="ShowLive">● Live (@LiveCount)</button>
            <button class="filter-chip @(_filter == "Upcoming" ? "active" : "")" @onclick="ShowUpcoming">Upcoming</button>
            <button class="filter-chip @(_filter == "Completed" ? "active" : "")" @onclick="ShowCompleted">Results</button>
        </div>

        @if (!FilteredMatches.Any())
        {
            <div class="empty-state">
                <h5>No matches in this feed</h5>
                <p class="mb-0">Switch tabs or check back later for updates.</p>
            </div>
        }
        else
        {
            <div class="match-list">
                @foreach (var match in FilteredMatches)
                {
                    var tournament = Data.GetTournament(match.TournamentId);
                    var teamAName = Data.TeamName(match.TeamAId) ?? "TBD";
                    var teamBName = Data.TeamName(match.TeamBId) ?? "TBD";
                    var teamATag = Data.TeamTag(match.TeamAId) ?? "TBD";
                    var teamBTag = Data.TeamTag(match.TeamBId) ?? "TBD";
                    var isLive = IsStatus(match, "Live");

                    <div class="match-row @(isLive ? "is-live" : "")">
                        <div>
                            <div class="match-tournament">@(tournament?.Name ?? "Unknown tournament")</div>
                            <div class="match-stage">@match.Stage · @match.BestOf · @(Data.GameName(match.GameId) ?? "Unknown game")</div>
                        </div>

                        <div class="match-scoreline">
                            <div class="team-line">
                                <span class="team-logo">@teamATag</span>
                                <div>
                                    <span class="team-name">@teamAName</span>
                                    <span class="team-tag">@teamATag</span>
                                </div>
                            </div>
                            <div class="scoreline-value">
                                <span class="score-number">@match.ScoreA</span>
                                <span class="score-separator">:</span>
                                <span class="score-number">@match.ScoreB</span>
                            </div>
                            <div class="team-line right">
                                <div>
                                    <span class="team-name">@teamBName</span>
                                    <span class="team-tag">@teamBTag</span>
                                </div>
                                <span class="team-logo">@teamBTag</span>
                            </div>
                        </div>

                        <div class="match-side">
                            <StatusChip Status="@match.Status" />
                            <span class="match-time">@FormatMatchTime(match.ScheduledAt)</span>
                            @if (isLive)
                            {
                                <span class="text-mono" style="font-size:.7rem; color:var(--neon-cyan);">In progress</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <aside>
        <div class="cyber-panel p-4 mb-4">
            <div class="admin-panel-title">
                <h4>Power rankings</h4>
                <span class="text-mono text-dim" style="font-size:.65rem;">Points</span>
            </div>
            @{
                var ranked = Data.Teams
                    .Where(t => string.Equals(t.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(t => t.Points)
                    .ThenBy(t => t.Name)
                    .Take(6)
                    .ToList();
            }
            @if (ranked.Count == 0)
            {
                <p class="text-dim mb-0">No approved teams yet.</p>
            }
            else
            {
                @for (var i = 0; i < ranked.Count; i++)
                {
                    var team = ranked[i];
                    <div class="pending-item">
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-mono text-dim" style="width:18px;">@(i + 1)</span>
                            <span class="team-logo" style="width:30px;height:30px;min-width:30px;font-size:.52rem;">@team.Tag</span>
                            <div>
                                <div class="name">@team.Name</div>
                                <div class="meta">@(Data.GameName(team.GameId) ?? "Unknown game")</div>
                            </div>
                        </div>
                        <span class="text-mono" style="color:var(--neon-cyan);">@team.Points</span>
                    </div>
                }
            }
        </div>

        <div class="cyber-panel p-4">
            <div class="admin-panel-title">
                <h4>Upcoming matches</h4>
                <span class="live-dot"></span>
            </div>
            @{
                var upcoming = Data.Matches
                    .Where(m => IsStatus(m, "Upcoming"))
                    .OrderBy(m => m.ScheduledAt == default ? DateTime.MaxValue : m.ScheduledAt)
                    .Take(4)
                    .ToList();
            }
            @if (upcoming.Count == 0)
            {
                <p class="text-dim mb-0">No upcoming matches scheduled.</p>
            }
            else
            {
                @foreach (var match in upcoming)
                {
                    <div class="pending-item">
                        <div>
                            <div class="name">@((Data.TeamTag(match.TeamAId) ?? "TBD")) vs @((Data.TeamTag(match.TeamBId) ?? "TBD"))</div>
                            <div class="meta">@(Data.GetTournament(match.TournamentId)?.Name ?? "Unknown tournament")</div>
                        </div>
                        <span class="match-time">@FormatShortDate(match.ScheduledAt)</span>
                    </div>
                }
            }
            <a href="/tournaments" class="btn-neon mt-2">View tournaments</a>
        </div>
    </aside>
</div>

@code {
    private string _filter = "All";

    private int LiveCount => Data.Matches.Count(m => IsStatus(m, "Live"));

    private IEnumerable<GameMatch> FilteredMatches => Data.Matches
        .Where(m => _filter == "All" || IsStatus(m, _filter))
        .OrderBy(m => StatusRank(m.Status))
        .ThenBy(m => IsStatus(m, "Completed")
            ? -(m.ScheduledAt == default ? DateTime.MinValue.Ticks : m.ScheduledAt.Ticks)
            : (m.ScheduledAt == default ? DateTime.MaxValue.Ticks : m.ScheduledAt.Ticks));

    private static bool IsStatus(GameMatch m, string status) =>
        string.Equals(m.Status, status, StringComparison.OrdinalIgnoreCase);

    private static int StatusRank(string? status)
    {
        if (string.Equals(status, "Live", StringComparison.OrdinalIgnoreCase)) return 0;
        if (string.Equals(status, "Upcoming", StringComparison.OrdinalIgnoreCase)) return 1;
        if (string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)) return 2;
        return 3;
    }

    private static string FormatMatchTime(DateTime dt) => dt == default ? "TBA" : dt.ToString("MMM dd · HH:mm");
    private static string FormatShortDate(DateTime dt) => dt == default ? "TBA" : dt.ToString("MMM dd");

    private void ShowAll() => _filter = "All";
    private void ShowLive() => _filter = "Live";
    private void ShowUpcoming() => _filter = "Upcoming";
    private void ShowCompleted() => _filter = "Completed";
}
