@page "/server-error"
@layout PublicLayout
@rendermode InteractiveServer

@using EsportPlatform.WEB.Services
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Server Unavailable — Nexus Arena</PageTitle>

<div class="server-error-page">
    <div class="server-error-card">
        <div class="error-icon">
            <i class="bi bi-cloud-slash"></i>
        </div>

        <span class="error-label">CONNECTION ERROR</span>

        <h1>Server unavailable</h1>

        <p class="error-description">
            We couldn't connect to the Nexus Arena server.
            The service may be temporarily unavailable.
        </p>

        @if (!string.IsNullOrWhiteSpace(_apiError))
        {
            <div class="error-details">
                <i class="bi bi-info-circle"></i>
                @_apiError
            </div>
        }

        <button class="retry-button"
                @onclick="RetryConnection"
                disabled="@_isChecking">

            @if (_isChecking)
            {
                <span class="spinner-border spinner-border-sm"></span>
                <span>Checking connection...</span>
            }
            else
            {
                <i class="bi bi-arrow-clockwise"></i>
                <span>Try again</span>
            }
        </button>

        <div class="error-footer">
            <span class="status-dot"></span>
            Waiting for the server
        </div>
    </div>
</div>

<style>
    .server-error-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: var(--bg);
        color: var(--text);
    }

    .server-error-card {
        width: 100%;
        max-width: 480px;
        padding: 48px 36px;
        text-align: center;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow-card);
    }

    .error-icon {
        width: 76px;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        border-radius: var(--radius);
        background: var(--accent-tint);
        color: var(--red-hover);
        font-size: 34px;
    }

    .error-label {
        color: var(--red-hover);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .server-error-card h1 {
        margin: 14px 0;
        font-size: 30px;
        font-weight: 800;
    }

    .error-description {
        color: var(--text-body);
        line-height: 1.7;
        font-size: 14px;
    }

    .error-details {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin: 24px 0;
        padding: 14px;
        text-align: left;
        color: var(--red-hover);
        background: var(--accent-tint);
        border: 1px solid rgba(var(--red-rgb), 0.3);
        border-radius: var(--radius-sm);
        font-size: 13px;
    }

    .retry-button {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 28px;
        padding: 14px 20px;
        color: #ffffff;
        background: var(--red);
        border: 1px solid var(--red);
        border-radius: var(--radius-sm);
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background .2s ease, border-color .2s ease;
    }

    .retry-button:hover:not(:disabled) {
        background: var(--red-hover);
        border-color: var(--red-hover);
    }

    .retry-button:disabled {
        opacity: .65;
        cursor: not-allowed;
    }

    .error-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 28px;
        color: var(--text-body);
        font-size: 12px;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: var(--radius-pill);
        background: var(--red);
    }
</style>

@code {
    private bool _isChecking;
    private string? _apiError;

    private async Task RetryConnection()
    {
        if (_isChecking)
            return;

        _isChecking = true;
        _apiError = null;

        try
        {
            
            

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (HttpRequestException ex)
        {
            _apiError = ex.Message;
        }
        catch (TaskCanceledException)
        {
            _apiError = "The server took too long to respond.";
        }
        finally
        {
            _isChecking = false;
        }
    }
}