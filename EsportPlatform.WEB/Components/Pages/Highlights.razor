@page "/highlights"
@rendermode InteractiveServer
@layout PublicLayout
@inherits ApiDataPage

<PageTitle>Highlights — Nexus Arena</PageTitle>

<div class="page-header">
    <div>
        <h1>Highlight reel</h1>
        <p class="sub">@Data.Highlights.Count clips · @TotalViews.ToString("N0") total views · the best plays from the arena</p>
    </div>
    <a href="/scores" class="btn-cyan">Match center</a>
</div>

@if (!Data.Highlights.Any())
{
    <div class="empty-state">
        <h5>No highlights yet</h5>
        <p class="mb-0">Check back after the next match day for the best plays.</p>
    </div>
}
else
{
    @if (Featured is not null)
    {
        <div class="highlight-feature">
            <div class="player-frame">
                <div class="player-surface" style="@PlayerStyle(Featured.GameId)">
                    <div class="player-overlay">
                        <div class="player-overlay-top">
                            <span class="chip highlight">✦ Highlight</span>
                            <span class="text-mono" style="font-size:.72rem; color:var(--text-body);">@Featured.Duration</span>
                        </div>
                        <div class="player-overlay-bottom">
                            <span class="text-mono" style="font-size:.68rem; color:var(--text-body); letter-spacing:1px;">
                                @Data.GameName(Featured.GameId) · @Featured.Views.ToString("N0") views
                            </span>
                            <span class="text-mono" style="font-size:.68rem; color:var(--text-body);">1080p60</span>
                        </div>
                    </div>

                    <div class="player-title">
                        <span class="game">@Data.GameName(Featured.GameId)</span>
                        <h3>@Featured.Title</h3>
                        <button class="big-play" @onclick="TogglePlay" title="Play / pause">@(_playing ? "❚❚" : "▶")</button>
                    </div>
                </div>

                <div class="player-meta">
                    <div>
                        <h4>@Featured.Title</h4>
                        <span>@Featured.MatchLabel · Published @Featured.PublishedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="chip">@Data.GameName(Featured.GameId)</span>
                        @if (!string.IsNullOrWhiteSpace(Featured.VideoUrl))
                        {
                            <a href="@Featured.VideoUrl" target="_blank" rel="noopener" class="btn-neon btn-tiny">Watch clip ↗</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <section class="section">
        <div class="section-head">
            <div>
                <h2>Latest highlights</h2>
                <p class="sub">Tap a clip to watch the play</p>
            </div>
            <span class="chip highlight">✦ @Data.Highlights.Count clips</span>
        </div>

        <div class="grid-3">
            @foreach (var highlight in FilteredHighlights)
            {
                <a class="stream-card @(highlight.Id == Featured?.Id ? "selected" : "")"
                   href="@(string.IsNullOrWhiteSpace(highlight.VideoUrl) ? "/highlights" : highlight.VideoUrl)"
                   target="@(string.IsNullOrWhiteSpace(highlight.VideoUrl) ? "_self" : "_blank")"
                   rel="noopener">
                    <div class="stream-thumb" style="@ThumbStyle(highlight.GameId)">
                        <span class="thumb-badge"><span class="chip highlight">✦ Highlight</span></span>
                        <span class="stream-play">▶</span>
                        <span class="thumb-duration">@highlight.Duration</span>
                    </div>
                    <div class="stream-body">
                        <h5>@highlight.Title</h5>
                        <p>@Data.GameName(highlight.GameId) · @highlight.Views.ToString("N0") views</p>
                        <p class="cell-sub mb-0">@highlight.MatchLabel · @highlight.PublishedAt.ToString("MMM dd")</p>
                    </div>
                </a>
            }
        </div>
    </section>
}

@code {
    private bool _playing = true;

    private Highlight? Featured => Data.Highlights.FirstOrDefault();

    private IEnumerable<Highlight> FilteredHighlights =>
        Data.Highlights.OrderByDescending(h => h.PublishedAt);

    private int TotalViews => Data.Highlights.Sum(h => h.Views);

    private void TogglePlay() => _playing = !_playing;

    private string ThumbStyle(int gameId)
    {
        var accent = Data.GetGame(gameId)?.Accent ?? "#8b5cf6";
        var art = GameArt.ForGame(Data.GetGame(gameId));
        return art is null
            ? $"background:radial-gradient(circle at 30% 20%, {accent}3d 0%, transparent 62%),linear-gradient(135deg, {accent}14 0%, var(--bg-2) 78%);"
            : $"background:linear-gradient(180deg, rgba(8,8,10,.12) 0%, rgba(8,8,10,.68) 100%),url('{art}') center/cover no-repeat;";
    }

    private string PlayerStyle(int gameId)
    {
        var accent = Data.GetGame(gameId)?.Accent ?? "#8b5cf6";
        var art = GameArt.ForGame(Data.GetGame(gameId));
        return art is null
            ? $"background:radial-gradient(circle at 25% 15%, {accent}33 0%, transparent 58%),radial-gradient(circle at 80% 85%, rgba(var(--cyan-rgb), .08) 0%, transparent 55%),var(--bg-2);"
            : $"background:linear-gradient(180deg, rgba(8,8,10,.16) 0%, rgba(8,8,10,.58) 100%),url('{art}') center/cover no-repeat;";
    }
}
