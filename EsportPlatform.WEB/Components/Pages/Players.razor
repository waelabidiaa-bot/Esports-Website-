@page "/players"
@rendermode InteractiveServer
@layout PublicLayout
@inherits ApiDataPage

<PageTitle>Player directory — EGames Jam</PageTitle>

<div class="page-header">
    <div>
        <h1>Player directory</h1>
        <p class="sub">@Data.Players.Count registered players · discover competitors, roles, and team assignments</p>
    </div>
    <a href="/register" class="btn-neon">Register a team</a>
</div>

<div class="filter-bar">
    <button class="filter-chip @(_filter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>All</button>
    <button class="filter-chip @(_filter == "assigned" ? "active" : "")" @onclick='() => SetFilter("assigned")'>On team</button>
    <button class="filter-chip @(_filter == "free" ? "active" : "")" @onclick='() => SetFilter("free")'>Free agents</button>
    <button class="filter-chip @(_filter == "active" ? "active" : "")" @onclick='() => SetFilter("active")'>Active</button>
    <input class="cyber-input filter-search" type="search" placeholder="Search players, teams, roles..." @bind="_search" @bind:event="oninput" />
</div>

@if (!FilteredPlayers.Any())
{
    <div class="empty-state">
        <h5>No players found</h5>
        <p class="mb-0">Try adjusting your filters or search.</p>
    </div>
}
else
{
    <div class="player-grid">
        @foreach (var player in FilteredPlayers)
        {
            var team = player.TeamId.HasValue ? Data.GetTeam(player.TeamId.Value) : null;
            var gameName = team is not null ? Data.GameName(team.GameId) : null;

            <article class="esport-card player-card">
                <div class="card-pad">
                    <div class="player-card-head">
                        <span class="player-avatar">@GetInitials(player.Gamertag)</span>
                        <div class="player-identity">
                            <div class="player-name-row">
                                <h3 class="player-gamertag">@player.Gamertag</h3>
                                <StatusChip Status="@player.Status" />
                            </div>
                            <div class="player-fullname">@(!string.IsNullOrWhiteSpace(player.FullName) ? player.FullName : "Unknown player")</div>
                            <div class="player-meta-line text-mono">@player.Role · @player.Country@(string.IsNullOrWhiteSpace(gameName) ? "" : $" · {gameName}")</div>
                        </div>
                    </div>

                    <div class="player-info-grid">
                        <div class="player-info-box">
                            <span class="player-info-label">Team</span>
                            <span class="player-info-value">@(team?.Name ?? "Free agent")</span>
                            <span class="player-info-sub">@(team is not null ? $"[{team.Tag}] · {team.Region}" : "Available for recruitment")</span>
                        </div>
                        <div class="player-info-box">
                            <span class="player-info-label">Status</span>
                            <span class="player-info-value">@player.Status</span>
                            <span class="player-info-sub">@(string.IsNullOrWhiteSpace(player.Email) ? "Profile registered" : "Contact on file")</span>
                        </div>
                    </div>

                    @if (team is not null)
                    {
                        <div class="player-footer">
                            <div class="player-roster-head">
                                <span>Team roster</span>
                                <strong>@team.RosterSize/@team.MaxRoster</strong>
                            </div>
                            <div class="progress-line">
                                <span style="width:@RosterPercent(team)"></span>
                            </div>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
}

@code {
    private string _filter = "all";
    private string _search = string.Empty;

    private IEnumerable<Player> FilteredPlayers
    {
        get
        {
            IEnumerable<Player> query = Data.Players;

            query = _filter switch
            {
                "free" => query.Where(p => !p.TeamId.HasValue),
                "assigned" => query.Where(p => p.TeamId.HasValue),
                "active" => query.Where(p => string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase)),
                _ => query
            };

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                query = query.Where(p =>
                    Contains(p.Gamertag, s) ||
                    Contains(p.FullName, s) ||
                    Contains(p.Role, s) ||
                    Contains(p.Country, s) ||
                    Contains(p.Status, s) ||
                    (p.TeamId.HasValue && Data.GetTeam(p.TeamId.Value) is { } team &&
                        (Contains(team.Name, s) || Contains(team.Tag, s) || Contains(team.Region, s))));
            }

            return query
                .OrderByDescending(p => string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .ThenBy(p => p.Gamertag);
        }
    }

    private void SetFilter(string filter) => _filter = filter;

    private static bool Contains(string? value, string search) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var trimmed = name.Trim();
        if (trimmed.Length <= 2) return trimmed.ToUpperInvariant();
        var parts = trimmed.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..2].ToUpperInvariant();
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
    }

    private static string RosterPercent(Team team)
    {
        if (team.MaxRoster <= 0) return "0%";
        var pct = Math.Clamp((double)team.RosterSize / team.MaxRoster * 100, 0, 100);
        return $"{Math.Round(pct)}%";
    }
}
