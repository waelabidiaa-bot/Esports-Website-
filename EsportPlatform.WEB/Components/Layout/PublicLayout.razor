@inherits LayoutComponentBase

@inject AuthService Auth

@implements IAsyncDisposable

<div class="public-shell">
    <header class="site-nav">
        <div class="site-nav-inner">
            <a href="/" class="site-brand">
                <span class="brand-mark">
                    <img src="assets/images/logo.png" alt="EGames Jam Logo" />
                </span>
                <span class="brand-text">EGames Jam</span>
            </a>

            <input type="checkbox" id="siteNavToggle" class="site-nav-toggle" />
            <label for="siteNavToggle" class="site-nav-burger" aria-label="Toggle navigation">☰</label>

            <nav class="site-nav-links">
                <NavLink class="site-nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink class="site-nav-link" href="games">Games</NavLink>
                <NavLink class="site-nav-link" href="tournaments">Tournaments</NavLink>
                <NavLink class="site-nav-link" href="teams">Teams</NavLink>
                <NavLink class="site-nav-link" href="scores">Scores</NavLink>
                <NavLink class="site-nav-link" href="highlights">Highlights</NavLink>

                @if (Auth.IsAuthenticated)
                {
                    @if (Auth.Session?.IsInRole("Admin") == true)
                    {
                        <a href="/admin" class="site-nav-cta">Admin Dashboard</a>
                    }
                    <a href="/account" class="site-nav-admin">Account</a>
                }
                else
                {
                    <a href="/register" class="site-nav-link">Join a team</a>
                    <a href="/signup" class="site-nav-cta">Sign up</a>
                }
            </nav>
        </div>
    </header>
    
    <main class="public-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private bool _restored;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _restored)
        {
            return;
        }

        _restored = true;
        await Auth.RestoreAsync();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        // Layout disposal - no explicit cleanup needed for AuthService
    }
}