@if (Game is null)
{
    <div class="game-banner game-banner-fallback"></div>
}
else if (Game.ImageData is { Length: > 0 })
{
    <div class="game-banner game-banner-image">
        <img src="@BannerSource" alt="@($"{Game.Name} banner")" />
        <span class="game-banner-genre">@Game.Genre</span>
    </div>
}
else if (GameArt.ForGame(Game) is { } art)
{
    <div class="game-banner game-banner-image">
        <img src="@art" alt="@($"{Game.Name} artwork")" loading="lazy" />
        <span class="game-banner-genre">@Game.Genre</span>
    </div>
}
else
{
    <div class="game-banner" style="@Style">
        <span class="game-banner-initial">@Initial</span>
        <span class="game-banner-genre">@Game.Genre</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public Game Game { get; set; } = new();

    private string Initial => string.IsNullOrWhiteSpace(Game.Name) ? "?" : Game.Name[..1].ToUpperInvariant();

    private string BannerSource =>
        $"data:{Game.ImageContentType ?? "image/png"};base64,{Convert.ToBase64String(Game.ImageData!)}";

    private string Style =>
        $"--accent:{Game.Accent};background:radial-gradient(circle at 18% 12%, {Game.Accent}33 0%, transparent 62%),linear-gradient(135deg, {Game.Accent}14 0%, var(--bg-2) 74%);border-bottom:1px solid var(--line-soft);";
}
