<span class="chip @CssClass">@Status</span>

@code {
    [Parameter] public string Status { get; set; } = "Open";

    private string CssClass => Status?.ToLowerInvariant() switch
    {
        "live" => "live",
        "open" => "open",
        "upcoming" => "upcoming",
        "completed" => "done",
        "pending" => "pending",
        "approved" => "approved",
        "suspended" => "suspended",
        "active" => "open",
        "bench" => "upcoming",
        "highlight" => "highlight",
        _ => ""
    };
}
